FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      setExprFieldsDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Initialise the interior with the same fully developed log-law profile as
// the inlet BCs, so the rigid-bed spin-up stage only has to relax the flow
// near the bed instead of starting the whole domain from rest.
//
//   U(z)     = (ustar/kappa) * ln(30 z / ks)      (z > 0, water column)
//   omega(z) = ustar / (sqrt(Cmu) kappa z)
//
//   ustar = 0.01617 m/s, kappa = 0.41, ks = 2.5*d50 = 1.5e-3 m
//   ustar/kappa = 0.0394390
//
// Run AFTER setFields (alpha.a), BEFORE the spin-up stage:
//   setExprFields
// U.a is left untouched (zero), the sediment region gets zero velocity.

expressions
(
    UbInit
    {
        field       U.b;
        dimensions  [0 1 -1 0 0 0 0];

        expression
        #{
            (pos().z() > 0)
          ? vector(0.0394390*log(30.0*max(pos().z(), 5.0e-5)/1.5e-3), 0, 0)
          : vector(0, 0, 0)
        #};
    }

    omegabInit
    {
        field       omega.b;
        dimensions  [0 0 -1 0 0 0 0];

        expression
        #{
            (pos().z() > 0)
          ? 0.01617/(0.3*0.41*max(pos().z(), 5.0e-5))
          : 5.3
        #};
    }
);

