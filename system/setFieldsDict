FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      setFieldsDict;
}

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

defaultFieldValues
(
    volScalarFieldValue alpha.a 0
);

regions
(
    boxToCell
    {
        box (-0.81 -0.1251 -0.061) (0.6 0.1251 0.0);

        fieldValues
        (
            // 0.60: close to random loose packing.
            // 0.58 sits right above alphaMinFriction (0.57) and lets the
            // bed settle/compact during the run, contaminating the scour
            // depth reading relative to the initial bed level.
            volScalarFieldValue alpha.a 0.60
        );
    }
);

