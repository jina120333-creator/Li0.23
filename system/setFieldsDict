FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      setFieldsDict;
}

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

defaultFieldValues
(
    volScalarFieldValue alpha.a 0
);

regions
(
    boxToCell
    {
        box (-0.81 -0.1251 -0.061) (0.6 0.1251 0.0);

        fieldValues
        (
            // Placeholder only: setExprFields (run right after setFields,
            // see Allrun) overwrites alpha.a in z < 0 with the
            // Johnson-Jackson hydrostatic-equilibrium compaction profile,
            // so the bed does not collapse at t = 0.
            volScalarFieldValue alpha.a 0.60
        );
    }
);

