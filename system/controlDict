FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     sedFoam;

startFrom       latestTime; //startTime;

startTime       startFrom;

stopAt          endTime;

// Two-stage run (see README_scour_comparison.md):
//   Stage 1 (rigid-bed spin-up):   t = 0..60    -> Allrun writes endTime 60
//   Stage 2 (scour, mobile bed):   t = 60..360  -> Allrun writes endTime 360
// The scour clock is t_exp = t_sim - 60, so t_sim = 360 corresponds to
// 300 s of scour time (t* = 11, the paper's first PIV instant).
// endTime lives in system/endTimeControl so the Allrun script can switch
// stages without rewriting (and de-commenting) this file.
#include        "endTimeControl"

deltaT          1e-6; //1e-4;

writeControl    adjustableRunTime;

// 2 s between full-field writes (0.1 s produced ~3600 time dirs over a full
// run). The scour-depth time series is sampled every 1 s by the 'bedLevels'
// functionObject below, independently of the field write interval.
writeInterval   2; //0.1;//0.05; //

//purgeWrite      0;

writeFormat     binary;

writePrecision  6;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable yes;

adjustTimeStep  yes;

// Conservative Courant number for sediment-water coupled calculation.
maxCo           0.5;//1;//0.25; //0.5; //range 0.5-1.0

maxAlphaCo      0.5;//1;//0.3; //0.5; 

// Maximum allowed time step.
// With local refined cells of about 0.625 mm and U0 = 0.233 m/s,
// dt around 5e-4 to 7e-4 s gives Co around 0.2-0.3.
maxDeltaT       3e-3; //1e-3; //5e-4; //2e-4;

libs (
"libturbulenceModels.so"
"libgroovyBC.so"
"libgroovyStandardBCs.so"
     );

OptimisationSwitches
  {
      //- Parallel IO file handler
      // uncollated (default), collated or masterUncollated
      fileHandler collated;

      //- collated: thread buffer size for queued file writes.
      // If set to 0 or not sufficient for the file size threading is not used.
      // Default: 2e9
      maxThreadFileBufferSize 0;

      //- masterUncollated: non-blocking buffer size.
      // If the file exceeds this buffer size scheduled transfer is used.
      // Default: 2e9
      maxMasterFileBufferSize 2e9;
  }

/*DebugSwitches
{
    dimensionSet    0;
}*/

functions
{
    /*
    // yPlus is intentionally not activated at this stage.
    // For sedFoam, yPlus availability depends on turbulence model and fields.
    // It is safer to run the case first, then post-process separately.

    yPlus
    {
        type            yPlus;
        libs            ("libfieldFunctionObjects.so");
        writeControl    writeTime;
    }

    wallShearStress
    {
        type            wallShearStress;
        libs            ("libfieldFunctionObjects.so");
        writeControl    writeTime;
    }
    */

    // ------------------------------------------------------------------
    // Approach-flow monitor: vertical profile of U.b and k.b at x = -0.4 m
    // (10D upstream of the pier). Used to (a) verify the log-law profile
    // survives the 0.8 m approach reach and (b) decide when the rigid-bed
    // spin-up has converged: depth-averaged U ~ 0.233 m/s, and u* from a
    // log-law fit ~ 0.016 m/s. See scripts/check_approach_flow.py.
    // ------------------------------------------------------------------
    approachFlow
    {
        type            sets;
        libs            (sampling);
        writeControl    adjustableRunTime;
        writeInterval   5;
        setFormat       csv;
        interpolationScheme cellPoint;
        fields          (U.b k.b);

        sets
        (
            approach
            {
                type    uniform;
                axis    z;
                start   (-0.4 0 0.0005);
                end     (-0.4 0 0.0495);
                nPoints 99;
            }
        );
    }

    // ------------------------------------------------------------------
    // Bed-level monitor: vertical alpha.a profiles at the pier front and
    // both sides, 2.5 mm off the pier surface (the experiment reads the
    // scour depth from a scale label on the pier itself).
    // Post-processed by scripts/extract_scour.py into S(t) and S/D vs t*.
    // ------------------------------------------------------------------
    bedLevels
    {
        type            sets;
        libs            (sampling);
        writeControl    adjustableRunTime;
        writeInterval   1;
        setFormat       csv;
        interpolationScheme cellPoint;
        fields          (alpha.a);

        sets
        (
            front   // upstream face, (x, y) = (-0.0225, 0)
            {
                type    uniform;
                axis    z;
                start   (-0.0225  0      -0.045);
                end     (-0.0225  0       0.005);
                nPoints 201;
            }
            sideL   // left flank, (x, y) = (0, +0.0225)
            {
                type    uniform;
                axis    z;
                start   ( 0        0.0225 -0.045);
                end     ( 0        0.0225  0.005);
                nPoints 201;
            }
            sideR   // right flank, (x, y) = (0, -0.0225)
            {
                type    uniform;
                axis    z;
                start   ( 0       -0.0225 -0.045);
                end     ( 0       -0.0225  0.005);
                nPoints 201;
            }
        );
    }
}


