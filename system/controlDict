FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     sedFoam;

startFrom       latestTime; //startTime;

startTime       startFrom;

stopAt          endTime;

// The flow is developed beforehand in the rigid-bed precursor case
// (precursor/, single-phase pimpleFoam) and mapped into the 0 folder, so
// this sedFoam run is scour-only with a mobile bed from t = 0:
//   t_exp = t_sim  (t* = 11 at ~298 s; see README_scour_comparison.md).
// endTime lives in system/endTimeControl so the Allrun script can set it
// without rewriting this file.
#include        "endTimeControl"

deltaT          1e-6; //1e-4;

writeControl    adjustableRunTime;

// 2 s between full-field writes (0.1 s produced ~3600 time dirs over a full
// run). The scour-depth time series is sampled every 1 s by the 'bedLevels'
// functionObject below, independently of the field write interval.
writeInterval   2; //0.1;//0.05; //

//purgeWrite      0;

writeFormat     binary;

writePrecision  6;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable yes;

adjustTimeStep  yes;

// maxCo / maxAlphaCo / maxDeltaT live in system/timeStepControl (written
// by Allrun). Keep maxDeltaT small (2e-4, the 3DScour tutorial value): the
// flow Courant number does NOT limit the granular bed dynamics - the
// Johnson-Jackson contact pressure pff varies by orders of magnitude per
// 0.01 change in alpha, so the bed relaxation transient is far stiffer
// than the flow CFL.
#include        "timeStepControl"

libs (
"libturbulenceModels.so"
"libgroovyBC.so"
"libgroovyStandardBCs.so"
     );

OptimisationSwitches
  {
      //- Parallel IO file handler
      // uncollated (default), collated or masterUncollated
      fileHandler collated;

      //- collated: thread buffer size for queued file writes.
      // If set to 0 or not sufficient for the file size threading is not used.
      // Default: 2e9
      maxThreadFileBufferSize 0;

      //- masterUncollated: non-blocking buffer size.
      // If the file exceeds this buffer size scheduled transfer is used.
      // Default: 2e9
      maxMasterFileBufferSize 2e9;
  }

/*DebugSwitches
{
    dimensionSet    0;
}*/

functions
{
    /*
    // yPlus is intentionally not activated at this stage.
    // For sedFoam, yPlus availability depends on turbulence model and fields.
    // It is safer to run the case first, then post-process separately.

    yPlus
    {
        type            yPlus;
        libs            ("libfieldFunctionObjects.so");
        writeControl    writeTime;
    }

    wallShearStress
    {
        type            wallShearStress;
        libs            ("libfieldFunctionObjects.so");
        writeControl    writeTime;
    }
    */

    // ------------------------------------------------------------------
    // Approach-flow monitor: vertical profile of U.b and k.b at x = -0.4 m
    // (10D upstream of the pier). Verifies that the mapped precursor flow
    // (depth-averaged U ~ 0.233 m/s, log-law fit u* ~ 0.016 m/s) is
    // maintained during the scour run. See scripts/check_approach_flow.py
    // (use --case precursor to check the flow-development run itself).
    // ------------------------------------------------------------------
    approachFlow
    {
        type            sets;
        libs            (sampling);
        writeControl    adjustableRunTime;
        writeInterval   5;
        setFormat       csv;
        interpolationScheme cellPoint;
        fields          (U.b k.b);

        sets
        (
            approach
            {
                type    uniform;
                axis    z;
                start   (-0.4 0 0.0005);
                end     (-0.4 0 0.0495);
                nPoints 99;
            }
        );
    }

    // ------------------------------------------------------------------
    // Bed-level monitor: vertical alpha.a profiles at the pier front and
    // both sides, 2.5 mm off the pier surface (the experiment reads the
    // scour depth from a scale label on the pier itself).
    // Post-processed by scripts/extract_scour.py into S(t) and S/D vs t*.
    // ------------------------------------------------------------------
    bedLevels
    {
        type            sets;
        libs            (sampling);
        writeControl    adjustableRunTime;
        writeInterval   1;
        setFormat       csv;
        interpolationScheme cellPoint;
        fields          (alpha.a);

        sets
        (
            front   // upstream face, (x, y) = (-0.0225, 0)
            {
                type    uniform;
                axis    z;
                start   (-0.0225  0      -0.045);
                end     (-0.0225  0       0.005);
                nPoints 201;
            }
            sideL   // left flank, (x, y) = (0, +0.0225)
            {
                type    uniform;
                axis    z;
                start   ( 0        0.0225 -0.045);
                end     ( 0        0.0225  0.005);
                nPoints 201;
            }
            sideR   // right flank, (x, y) = (0, -0.0225)
            {
                type    uniform;
                axis    z;
                start   ( 0       -0.0225 -0.045);
                end     ( 0       -0.0225  0.005);
                nPoints 201;
            }
        );
    }
}


