FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      pa;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    // zeroGradient like the sedFoam 3DScour tutorial: the particle
    // pressure at the bottom/pier walls must be free to carry the bed
    // weight; fixedValue 0 kills the support exactly where it is needed.
    "(sideWalls|bottom|pier)"
    {
        type            zeroGradient;
    }
    top
    {
        type            zeroGradient;
    }
    //inletWater
    "inletWater.*"
    {
        type            zeroGradient;
    }
    inletSediment
    {
        type            zeroGradient;
    }
    outletWater
    {
        type            zeroGradient;
    }
    outletSediment
    {
        type            zeroGradient;
    }

}


