FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      transportProperties;
}

// * * * * * * * * * * 단상유동 (물만) 특성 * * * * * * * * * * //

transportModel  Newtonian;

nu              nu [ 0 2 -1 0 0 0 0 ] 1.0e-6;  // 물의 동점성 (20°C)

rho             rho [ 1 -3 0 0 0 0 0 ] 1000;  // 물의 밀도

