FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      turbulenceProperties;
}

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

simulation RAS;  // Reynolds-Averaged Simulation

RAS
{
    // k-epsilon 난류 모델 (표준 선택)
    // k-omega SST로 변경 가능: kOmegaSST
    // 층류 유동: laminar
    RASModel        kEpsilon;

    turbulence      on;

    printCoeffs     on;
}

