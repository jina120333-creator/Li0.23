#!/bin/sh
cd "${0%/*}" || exit 1

rm -rf 0 processor* postProcessing dynamicCode
rm -f log.*

# keep only 0 as start time: remove numbered time directories
for d in [0-9]* [0-9]*.[0-9]*
do
    [ -d "$d" ] && [ "$d" != 0 ] && rm -rf "$d"
done

# mesh generated by blockMesh/snappyHexMesh
rm -rf constant/polyMesh constant/extendedFeatureEdgeMesh constant/triSurface/*.eMesh 2>/dev/null

# restore stage-control includes to their committed defaults
cat > constant/musControl << 'EOF'
// Managed by Allrun:
//   spin-up stage (rigid bed): mus = 10   (bed effectively immobile)
//   scour stage  (mobile bed): mus = 0.35 (physical value, mu(I) rheology)
mus             mus  [ 0 0 0 0 0 0 0 ] 0.35;
EOF
cat > system/endTimeControl << 'EOF'
// Managed by Allrun: stage 1 (spin-up) writes 60, stage 2 (scour) writes 360.
endTime         360;
EOF

echo "cleaned."
