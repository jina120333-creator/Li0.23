FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    location    "0";
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    inletWater
    {
        // Same log-law ramp as the fluid-phase inlet (U.b) in the sedFoam case.
        type            codedFixedValue;
        value           uniform (0 0 0);
        name            logLawInlet;
        code
        #{
            const scalar ustar = 0.01617;
            const scalar kappa = 0.41;
            const scalar ks    = 1.5e-3;   // 2.5*d50
            const scalar tRamp = 2.0;
            const scalar t  = this->db().time().value();
            const scalar fr = min(t/tRamp, 1.0);
            vectorField& U = *this;
            const vectorField& Cf = patch().Cf();
            forAll(U, i)
            {
                scalar z = max(Cf[i].z(), ks/30.0);
                U[i] = vector(fr*(ustar/kappa)*log(30.0*z/ks), 0, 0);
            }
        #};
    }

    outletWater
    {
        type            zeroGradient;
    }

    "(sideWalls|bottom|pier)"
    {
        type            noSlip;
    }

    top
    {
        type            slip;
    }
}

