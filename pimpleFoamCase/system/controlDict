FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     pimpleFoam;

startFrom       latestTime;

startTime       0;

stopAt          endTime;

// Same physical time window as the sedFoam run, for direct comparison.
endTime         300;

deltaT          1e-4;

writeControl    adjustableRunTime;

writeInterval   0.1;

writeFormat     binary;

writePrecision  6;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable yes;

adjustTimeStep  yes;

maxCo           0.5;

maxDeltaT       3e-3;

OptimisationSwitches
{
    fileHandler collated;
    maxThreadFileBufferSize 0;
    maxMasterFileBufferSize 2e9;
}

