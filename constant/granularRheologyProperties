FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      granaularRheologyProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

granularRheology   on;//off;

granularDilatancy  off;

granularCohesion  off;

// alphaMaxG MUST stay strictly BELOW alphaMax (0.635, ppProperties):
// with PPressureModel MuI the dilatant pressure
//   pa = (Bphi*alpha/(alphaMaxG-alpha))^2 * rhoa*da^2*|D|^2
// diverges as alpha -> alphaMaxG, so compaction is stopped at 0.625 and
// alpha can never reach the Johnson-Jackson pff singularity at 0.635.
// (0.625 = sedFoam 3DScour tutorial value, Nagel et al. 2020.)
alphaMaxG       alphaMaxG [ 0 0 0 0 0 0 0 ] 0.625;

// mus AND mu2 live in constant/musControl (written by Allrun). The values
// are the physical sand-in-water ones (0.63/1.13) for the whole run: the
// flow is developed beforehand in the rigid-bed precursor case, so there is
// no mus-based bed-freezing stage any more (freezing via a huge mus kept
// blowing up - in a quasi-static bed |D| ~ 0, so the dilatant pressure
// cannot stop compaction and alpha still hits the Johnson-Jackson
// singularity). IMPORTANT: keep mu2 > mus at all times; mu2 < mus is
// velocity-weakening friction and mathematically ill-posed.
#include        "musControl"

// I0, Bphi: mu(I)/dilatancy coefficients for sand in water from the
// sedFoam 3DScour tutorial (Nagel et al. 2020, cylinder scour, validated).
I0              I0  [ 0 0 0 0 0 0 0 ] 0.6;

Bphi            Bphi [ 0 0 0 0 0 0 0 ] 0.66;

n               n [ 0 0 0 0 0 0 0 ] 2.5;

Dsmall          Dsmall [ 0 0 -1 0 0 0 0 ] 1e-4;

// Consolidation time scale for pa (tau_inv = relaxPa*alpha*|D|).
// relaxPa = 1 makes pa follow the instantaneous equilibrium value, which
// lets the settling bed oscillate; 3e-4 (tutorial value) gives pa a memory
// and damps the compaction transient.
relaxPa         relaxPa [ 0 0 0 0 0 0 0 ] 3e-4;

FrictionModel   MuI;

// MuI (NOT none): shear-induced/dilatant particle pressure. This is the
// term that resists over-compaction of the bed. With 'none' the only
// particle pressure is the Johnson-Jackson pff, which is negligible up to
// alpha ~ 0.61 and singular at 0.635 - so the collapsing bed shot straight
// into pff ~ 1e10 Pa and stayed pinned there (the spin-up blow-up).
PPressureModel  MuI;

FluidViscosityModel BoyerEtAl;

// ************************************************************************* //
